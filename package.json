{
  "name": "bosco",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "db:migrate": "pnpm --filter @bosco/db db:migrate",
    "db:seed": "pnpm --filter @bosco/db db:seed",
    "openapi:check": "pnpm --filter @bosco/api generate:openapi && git diff --exit-code -- apps/api/openapi.json",
    "i18n:check": "pnpm --filter @bosco/web i18n:check",
    "openspec": "openspec",
    "openspec:init": "openspec init",
    "openspec:validate": "openspec validate --all",
    "openwiki": "openwiki",
    "openwiki:init": "openwiki --init",
    "openwiki:generate": "openwiki --update",
    "openwiki:serve": "openwiki visualize",
    "docs:generate": "pnpm openwiki:generate",
    "docs:setup": "node scripts/setup-docs.mjs",
    "docs:validate": "pnpm openspec:validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@fission-ai/openspec": "^2.1.1",
    "eslint": "^9.14.0",
    "openwiki": "^0.9.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.14.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
