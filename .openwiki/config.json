{
  "$schema": "https://raw.githubusercontent.com/langchain-ai/openwiki/main/packages/cli/config-schema.json",
  "name": "bosco",
  "version": "0.0.1",
  "description": "Bosco OpenWiki - Self-hosted engineering management tool documentation",
  "repository": "https://github.com/jonperron/bosco",
  "license": "Apache-2.0",
  
  "rootDir": ".",
  "sourceDir": "wiki",
  "outputDir": "docs/wiki",
  
  "language": "fr",
  "additionalLanguages": ["en"],
  
  "ai": {
    "enabled": true,
    "provider": "openai",
    "model": "gpt-4",
    "temperature": 0.3,
    "maxTokens": 4096
  },
  
  "indexing": {
    "enabled": true,
    "include": [
      "packages/**/*.ts",
      "apps/**/*.ts",
      "docs/**/*.md",
      "specs/**/*.yaml",
      "*.md"
    ],
    "exclude": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".turbo/**",
      ".pnpm-store/**"
    ]
  },
  
  "generation": {
    "autoGenerate": true,
    "watch": true,
    "checkpointDir": ".openwiki/checkpoints",
    "maxIterations": 10
  },
  
  "serve": {
    "port": 3001,
    "host": "localhost",
    "open": true
  },
  
  "search": {
    "enabled": true,
    "indexName": "bosco-wiki"
  },
  
  "analytics": {
    "enabled": false
  },
  
  "navigation": {
    "structure": [
      {
        "label": "Accueil",
        "path": "/"
      },
      {
        "label": "Documentation",
        "items": [
          {
            "label": "Introduction",
            "path": "/introduction"
          },
          {
            "label": "Installation",
            "path": "/installation"
          },
          {
            "label": "Configuration",
            "path": "/configuration"
          },
          {
            "label": "API Reference",
            "path": "/api"
          },
          {
            "label": "Modules",
            "path": "/modules"
          }
        ]
      },
      {
        "label": "Développement",
        "items": [
          {
            "label": "Architecture",
            "path": "/architecture"
          },
          {
            "label": "Contribution",
            "path": "/contribution"
          },
          {
            "label": "Tests",
            "path": "/tests"
          }
        ]
      },
      {
        "label": "Spécifications",
        "path": "/specs"
      }
    ]
  },
  
  "metadata": {
    "authors": [
      {
        "name": "Jonathan Perron",
        "email": "jonperron@example.com"
      }
    ],
    "keywords": [
      "bosco",
      "engineering",
      "management",
      "self-hosted",
      "typescript",
      "nestjs",
      "react",
      "postgres"
    ]
  }
}
