# Bosco API environment. Copy to .env next to this file (git-ignored).

# HTTP port of the API (defaults to 3000)
PORT=3000

# Serve the Swagger UI of the contract at /api/docs.
# Off unless enabled; turn it on deliberately (e.g. local development).
#API_DOCS_ENABLED=false

# Optional: directory of the built frontend to serve
# (defaults to the sibling apps/web/dist when it exists)
#WEB_DIST=

# --- Required: the API refuses to start without these. ---

# Postgres database; the API applies pending migrations at startup.
# Same value as DATABASE_URL in the repository root .env during development.
DATABASE_URL=postgres://bosco:bosco@localhost:5432/bosco

# Public origin of the install, no path. Must be https, except on localhost.
# Google redirects back to <PUBLIC_URL>/api/auth/callback.
PUBLIC_URL=http://localhost:3000

# OAuth client (type "Web application") of the company's Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The company's Google Workspace domain: any verified account of this domain
# signs itself in as a manager on first login; no other account can.
GOOGLE_WORKSPACE_DOMAIN=example.com
