    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^26",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
