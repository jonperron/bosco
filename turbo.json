{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "generate": {
      "cache": true,
      "inputs": ["$TURBO_ROOT$/apps/api/openapi.json"],
      "outputs": ["src/gen/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    },
    "test:e2e": {
      "dependsOn": ["build", "@bosco/api#build"],
      "cache": false,
      "passThroughEnv": ["CI", "E2E_PORT", "WEB_DIST"]
    }
  }
}
