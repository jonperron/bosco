{
  "name": "@bosco/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client for the Bosco API, generated from the committed OpenAPI contract",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/gen/schema.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  }
}
